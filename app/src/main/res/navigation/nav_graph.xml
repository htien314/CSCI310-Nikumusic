<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared navigation graph. Every destination starts as PlaceholderFragment.
  When your screen is ready, change its android:name to your Fragment class.
  Pass a ride between screens with the "rideId" argument (Constants.ARG_RIDE_ID).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

    <!-- Bottom navigation tabs -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.trojanrideshare.ui.common.PlaceholderFragment"
        android:label="Search Rides">
        <argument android:name="title" app:argType="string" android:defaultValue="Search Rides" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Nikhil" />
    </fragment>

    <fragment
        android:id="@+id/createRideFragment"
        android:name="com.example.trojanrideshare.ui.ride.CreateRideFragment"
        android:label="Create Ride" />

    <fragment
        android:id="@+id/myRidesFragment"
        android:name="com.example.trojanrideshare.ui.common.PlaceholderFragment"
        android:label="My Rides &amp; Requests">
        <argument android:name="title" app:argType="string" android:defaultValue="My Rides &amp; Requests" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Hailey" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.trojanrideshare.ui.common.PlaceholderFragment"
        android:label="Profile">
        <argument android:name="title" app:argType="string" android:defaultValue="Profile" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Riya" />
    </fragment>

    <!-- Account (Riya) -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.trojanrideshare.ui.common.PlaceholderFragment"
        android:label="Log In">
        <argument android:name="title" app:argType="string" android:defaultValue="Log In" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Riya" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.trojanrideshare.ui.common.PlaceholderFragment"
        android:label="Sign Up">
        <argument android:name="title" app:argType="string" android:defaultValue="Sign Up" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Riya" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.trojanrideshare.ui.common.PlaceholderFragment"
        android:label="Ride History">
        <argument android:name="title" app:argType="string" android:defaultValue="Ride History" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Riya" />
    </fragment>

    <!-- Rides (Ada) -->
    <fragment
        android:id="@+id/rideDetailsFragment"
        android:name="com.example.trojanrideshare.ui.ride.RideDetailsFragment"
        android:label="Ride Details">
        <argument android:name="rideId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
    </fragment>

    <!-- Membership (Hailey) -->
    <fragment
        android:id="@+id/requestsInboxFragment"
        android:name="com.example.trojanrideshare.ui.common.PlaceholderFragment"
        android:label="Join Requests">
        <argument android:name="title" app:argType="string" android:defaultValue="Join Requests" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Hailey" />
        <argument android:name="rideId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
    </fragment>

    <!-- Cost (Estelle) -->
    <fragment
        android:id="@+id/completeRideFragment"
        android:name="com.example.trojanrideshare.ui.ride.CompleteRideFragment"
        android:label="Complete Ride">
        <argument android:name="title" app:argType="string" android:defaultValue="Complete Ride" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Estelle" />
        <argument android:name="rideId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
    </fragment>


    <!-- Payment Tracking (Estelle) -->
    <fragment
        android:id="@+id/paymentTrackingFragment"
        android:name="com.example.trojanrideshare.ui.ride.PaymentTrackingFragment"
        android:label="Ride Payments">
        <argument android:name="rideId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/monthlySummaryFragment"
        android:name="com.example.trojanrideshare.ui.ride.MonthlySummaryFragment"
        android:label="Monthly Summary">
        <argument android:name="title" app:argType="string" android:defaultValue="Monthly Summary" />
        <argument android:name="owner" app:argType="string" android:defaultValue="Estelle" />
    </fragment>

    <!-- Global actions so any screen can open these -->
    <action android:id="@+id/action_global_rideDetails" app:destination="@id/rideDetailsFragment" />
    <action android:id="@+id/action_global_requestsInbox" app:destination="@id/requestsInboxFragment" />
    <action android:id="@+id/action_global_completeRide" app:destination="@id/completeRideFragment" />
    <action android:id="@+id/action_global_history" app:destination="@id/historyFragment" />
    <action android:id="@+id/action_global_monthlySummary" app:destination="@id/monthlySummaryFragment" />
    <action android:id="@+id/action_global_login" app:destination="@id/loginFragment" />
    <action android:id="@+id/action_global_register" app:destination="@id/registerFragment" />
    <action android:id="@+id/action_global_paymentTracking" app:destination="@id/paymentTrackingFragment" />

</navigation>
