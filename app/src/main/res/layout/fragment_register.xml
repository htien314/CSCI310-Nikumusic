<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/app_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <include layout="@layout/brand_wordmark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create Account" android:layout_marginBottom="8dp" android:textAppearance="@style/TextAppearance.Trojan.Title" />
        <ImageView android:layout_width="match_parent" android:layout_height="128dp" android:src="@drawable/ride_illustration" android:scaleType="fitCenter" android:importantForAccessibility="no" android:layout_marginBottom="20dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Join the USC ride community." android:textAppearance="@style/TextAppearance.Trojan.Subtitle" android:layout_marginBottom="24dp" />
        <EditText android:id="@+id/inputFullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Full Name" android:inputType="textPersonName" style="@style/Widget.Trojan.Input" android:layout_marginBottom="12dp" android:minHeight="56dp" />
        <EditText android:id="@+id/inputNickname" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nickname (optional)" android:inputType="textPersonName" style="@style/Widget.Trojan.Input" android:layout_marginBottom="12dp" android:minHeight="56dp" />
        <EditText android:id="@+id/inputEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="USC Email" android:inputType="textEmailAddress" style="@style/Widget.Trojan.Input" android:layout_marginBottom="12dp" android:minHeight="56dp" />
        <EditText android:id="@+id/inputUscId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="10-digit USC ID" android:inputType="number" android:maxLength="10" style="@style/Widget.Trojan.Input" android:layout_marginBottom="12dp" android:minHeight="56dp" />
        <EditText android:id="@+id/inputGraduationYear" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Expected Graduation Year" android:inputType="number" android:maxLength="4" style="@style/Widget.Trojan.Input" android:layout_marginBottom="12dp" android:minHeight="56dp" />
        <EditText android:id="@+id/inputPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Password" android:inputType="textPassword" style="@style/Widget.Trojan.Input" android:layout_marginBottom="12dp" android:minHeight="56dp" />
        <Button android:id="@+id/buttonRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create Account" android:layout_marginTop="24dp" />
        <TextView android:id="@+id/textRegistrationError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/app_error" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
