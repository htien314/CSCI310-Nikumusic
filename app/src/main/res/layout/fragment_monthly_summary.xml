<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly summary"
            android:textColor="@color/app_ink"
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/design_summary_intro"
            android:textColor="@color/app_muted"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPreviousMonth"
                style="@style/Widget.Trojan.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:contentDescription="Previous month"
                android:minHeight="56dp"
                android:textAllCaps="false"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/textSelectedMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="November 2026"
                android:textColor="@color/app_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNextMonth"
                style="@style/Widget.Trojan.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:contentDescription="Next month"
                android:minHeight="56dp"
                android:textAllCaps="false"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_soft">
            <TextView
                android:id="@+id/textRideCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completed rides: —"
                android:textColor="@color/app_ink"
                android:textSize="17sp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/textOrganizedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rides organized: —"
                android:textColor="@color/app_ink"
                android:textSize="17sp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/textJoinedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rides joined: —"
                android:textColor="@color/app_ink"
                android:textSize="17sp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/textTotalCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Total ride costs: —"
                android:textColor="@color/app_ink"
                android:textSize="17sp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/textMyShare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="My share: —"
                android:textColor="@color/app_ink"
                android:textSize="17sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/textPaidAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Paid: —"
                android:textColor="@color/app_success"
                android:textSize="17sp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/textUnpaidAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Outstanding: —"
                android:textColor="@color/app_error"
                android:textSize="17sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/textMonthlyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Loading your monthly summary..."
            android:textColor="@color/app_muted"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />
        <TextView
            android:id="@+id/textMonthlyError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/app_error"
            android:visibility="gone"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>