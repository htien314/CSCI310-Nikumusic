<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ride Participants"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/app_ink"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/design_riders_intro"
            android:textSize="15sp"
            android:textColor="@color/app_muted"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />
        <TextView
            android:id="@+id/participantsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading participants..."
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="3dp" />
        <LinearLayout
            android:id="@+id/participantContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>