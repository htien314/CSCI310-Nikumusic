<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include
            android:id="@+id/loading_error"
            layout="@layout/view_loading_error" />

        <LinearLayout
            android:id="@+id/ride_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/ride_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <include android:id="@+id/row_activity" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_capacity" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_departure" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_original_departure" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_origin" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_destination" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_cost" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_organizer" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_riders" layout="@layout/view_ride_detail_row" />
            <include android:id="@+id/row_note" layout="@layout/view_ride_detail_row" />

            <LinearLayout
                android:id="@+id/organizer_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/action_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/delay_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/on_time_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ride_details_mark_on_time" />

                <Button
                    android:id="@+id/cancel_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ride_details_cancel"
                    android:textColor="?attr/colorError" />

                <!-- Organizer can complete the ride after departure. -->
                <Button
                    android:id="@+id/complete_ride_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Complete Ride"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- View payment records for a completed ride. -->
            <Button
                android:id="@+id/view_payments_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="View Payments"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
