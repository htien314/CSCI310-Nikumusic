<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <include layout="@layout/brand_wordmark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/search_heading" android:textAppearance="@style/TextAppearance.Trojan.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find someone going your way." android:textAppearance="@style/TextAppearance.Trojan.Subtitle" android:layout_marginBottom="24dp" />
        <com.example.trojanrideshare.ui.common.LocationPickerView android:id="@+id/pickup_picker" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/search_pickup" />
        <com.example.trojanrideshare.ui.common.LocationPickerView android:id="@+id/destination_picker" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/search_destination" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:hint="@string/search_radius" app:helperText="@string/search_radius_help" app:suffixText="@string/search_radius_unit">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/radius_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <Button style="@style/Widget.Material3.Button.TextButton" android:id="@+id/searchToggleFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/search_more_filters" />
        <LinearLayout android:id="@+id/searchAdvancedFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/date_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/search_any_date" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/earliest_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="@string/search_any_earliest" />
                <Button android:id="@+id/latest_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/search_any_latest" />
            </LinearLayout>
            <Button android:id="@+id/clear_filters_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/search_clear_date_time" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_open_seats" android:textAppearance="?attr/textAppearanceLabelLarge" />
            <Spinner android:id="@+id/seats_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/search_sort_by" android:textAppearance="?attr/textAppearanceLabelLarge" />
            <Spinner android:id="@+id/sort_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:minHeight="48dp" />
        </LinearLayout>
        <Button android:id="@+id/search_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/search_submit" />
        <include android:id="@+id/loading_error" layout="@layout/view_loading_error" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/results_summary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="?attr/textAppearanceTitleMedium" android:visibility="gone" />
            <Button android:id="@+id/clear_search_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_show_upcoming" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/results_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
