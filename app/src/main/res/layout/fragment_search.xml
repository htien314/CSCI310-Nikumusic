<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:ns0="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    ns0:layout_width="match_parent"
    ns0:layout_height="match_parent"
    ns0:background="@color/app_background"
    ns0:fillViewport="true"
    ns0:clipToPadding="false">
    <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:padding="20dp">
        <LinearLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:orientation="horizontal"
            ns0:background="@drawable/bg_brand"
            ns0:padding="20dp"
            ns0:gravity="center_vertical"
            ns0:layout_marginBottom="20dp">
            <LinearLayout
                ns0:layout_width="0dp"
                ns0:layout_height="wrap_content"
                ns0:layout_weight="1"
                ns0:orientation="vertical">
                <TextView
                    ns0:layout_width="match_parent"
                    ns0:layout_height="wrap_content"
                    ns0:text="MOVE TOGETHER"
                    ns0:textSize="10sp"
                    ns0:textColor="@color/usc_gold"
                    ns0:lineSpacingExtra="3dp"
                    ns0:letterSpacing="0.18"
                    ns0:fontFamily="sans-serif-medium"
                    ns0:layout_marginBottom="12dp" />
                <TextView
                    ns0:layout_width="match_parent"
                    ns0:layout_height="wrap_content"
                    ns0:text="@string/design_search_intro"
                    ns0:textSize="27sp"
                    ns0:textColor="@color/white"
                    ns0:fontFamily="serif"
                    ns0:lineSpacingExtra="1dp" />
                <TextView
                    ns0:layout_width="match_parent"
                    ns0:layout_height="wrap_content"
                    ns0:text="@string/design_search_body"
                    ns0:textSize="14sp"
                    ns0:textColor="@color/white"
                    ns0:lineSpacingExtra="3dp"
                    ns0:layout_marginTop="10dp" />
            </LinearLayout>
            <ImageView
                ns0:layout_width="72dp"
                ns0:layout_height="108dp"
                ns0:src="@drawable/hero_route"
                ns0:contentDescription="@null"
                ns0:importantForAccessibility="no"
                ns0:layout_marginStart="4dp" />
        </LinearLayout>
        <TextView
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="16dp"
            ns0:text="@string/search_heading"
            ns0:textAppearance="?attr/textAppearanceHeadlineSmall"
            ns0:lineSpacingExtra="3dp"
            ns0:textSize="26sp"
            ns0:fontFamily="sans-serif-medium"
            ns0:accessibilityHeading="true" />
        <com.example.trojanrideshare.ui.common.LocationPickerView
            ns0:id="@+id/pickup_picker"
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:hint="@string/search_pickup" />
        <com.example.trojanrideshare.ui.common.LocationPickerView
            ns0:id="@+id/destination_picker"
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:hint="@string/search_destination" />
        <com.google.android.material.textfield.TextInputLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="4dp"
            ns0:hint="@string/search_radius"
            ns1:helperText="@string/search_radius_help"
            ns1:suffixText="@string/search_radius_unit">
            <com.google.android.material.textfield.TextInputEditText
                ns0:id="@+id/radius_input"
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:inputType="numberDecimal"
                ns0:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            ns0:id="@+id/search_more_filters"
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:text="@string/design_filters"
            style="@style/Widget.Trojan.Secondary" />
        <LinearLayout
            ns0:id="@+id/search_filter_panel"
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:orientation="vertical"
            ns0:visibility="gone">
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/date_button"
                style="@style/Widget.Trojan.Secondary"
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="8dp"
                ns0:text="@string/search_any_date"
                ns0:minHeight="56dp"
                ns0:textAllCaps="false" />
            <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    ns0:id="@+id/earliest_button"
                    style="@style/Widget.Trojan.Secondary"
                    ns0:layout_width="0dp"
                    ns0:layout_height="wrap_content"
                    ns0:layout_marginEnd="8dp"
                    ns0:layout_weight="1"
                    ns0:text="@string/search_any_earliest"
                    ns0:minHeight="56dp"
                    ns0:textAllCaps="false"
                    ns0:layout_marginTop="4dp" />
                <com.google.android.material.button.MaterialButton
                    ns0:id="@+id/latest_button"
                    style="@style/Widget.Trojan.Secondary"
                    ns0:layout_width="0dp"
                    ns0:layout_height="wrap_content"
                    ns0:layout_weight="1"
                    ns0:text="@string/search_any_latest"
                    ns0:minHeight="56dp"
                    ns0:textAllCaps="false"
                    ns0:layout_marginTop="4dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/clear_filters_button"
                style="@style/Widget.Trojan.TextButton"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_gravity="end"
                ns0:text="@string/search_clear_date_time"
                ns0:minHeight="56dp"
                ns0:textAllCaps="false"
                ns0:layout_marginTop="4dp" />
            <TextView
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:text="@string/search_open_seats"
                ns0:textAppearance="?attr/textAppearanceLabelLarge"
                ns0:lineSpacingExtra="3dp" />
            <Spinner
                ns0:id="@+id/seats_spinner"
                ns0:layout_width="match_parent"
                ns0:layout_height="52dp"
                ns0:minHeight="52dp"
                ns0:background="@drawable/bg_card"
                ns0:paddingStart="12dp"
                ns0:paddingEnd="12dp"
                ns0:layout_marginBottom="8dp" />
            <TextView
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="8dp"
                ns0:text="@string/search_sort_by"
                ns0:textAppearance="?attr/textAppearanceLabelLarge"
                ns0:lineSpacingExtra="3dp" />
            <Spinner
                ns0:id="@+id/sort_spinner"
                ns0:layout_width="match_parent"
                ns0:layout_height="52dp"
                ns0:layout_marginBottom="8dp"
                ns0:minHeight="52dp"
                ns0:background="@drawable/bg_card"
                ns0:paddingStart="12dp"
                ns0:paddingEnd="12dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            ns0:id="@+id/search_button"
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:text="@string/search_submit"
            style="@style/Widget.Trojan.Button"
            ns0:minHeight="56dp"
            ns0:textAllCaps="false"
            ns0:layout_marginTop="4dp" />
        <include ns0:id="@+id/loading_error" layout="@layout/view_loading_error" />
        <LinearLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginTop="16dp"
            ns0:layout_marginBottom="8dp"
            ns0:gravity="center_vertical"
            ns0:orientation="horizontal">
            <TextView
                ns0:id="@+id/results_summary"
                ns0:layout_width="0dp"
                ns0:layout_height="wrap_content"
                ns0:layout_weight="1"
                ns0:textAppearance="?attr/textAppearanceTitleMedium"
                ns0:visibility="gone"
                ns0:lineSpacingExtra="3dp" />
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/clear_search_button"
                style="@style/Widget.Trojan.TextButton"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:text="@string/search_show_upcoming"
                ns0:visibility="gone"
                ns0:minHeight="56dp"
                ns0:textAllCaps="false"
                ns0:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout
            ns0:id="@+id/results_list"
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:orientation="vertical" />
    </LinearLayout>
</ScrollView>