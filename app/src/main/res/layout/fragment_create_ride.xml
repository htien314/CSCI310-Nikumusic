<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:ns0="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    ns0:layout_width="match_parent"
    ns0:layout_height="match_parent"
    ns0:background="@color/app_background"
    ns0:fillViewport="true"
    ns0:clipToPadding="false">
    <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:padding="20dp">
        <LinearLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:orientation="horizontal"
            ns0:background="@drawable/bg_brand"
            ns0:padding="20dp"
            ns0:gravity="center_vertical"
            ns0:layout_marginBottom="20dp">
            <LinearLayout
                ns0:layout_width="0dp"
                ns0:layout_height="wrap_content"
                ns0:layout_weight="1"
                ns0:orientation="vertical">
                <TextView
                    ns0:layout_width="match_parent"
                    ns0:layout_height="wrap_content"
                    ns0:text="MOVE TOGETHER"
                    ns0:textSize="10sp"
                    ns0:textColor="@color/usc_gold"
                    ns0:lineSpacingExtra="3dp"
                    ns0:letterSpacing="0.18"
                    ns0:fontFamily="sans-serif-medium"
                    ns0:layout_marginBottom="12dp" />
                <TextView
                    ns0:layout_width="match_parent"
                    ns0:layout_height="wrap_content"
                    ns0:text="@string/design_post_intro"
                    ns0:textSize="27sp"
                    ns0:textColor="@color/white"
                    ns0:fontFamily="serif"
                    ns0:lineSpacingExtra="1dp" />
                <TextView
                    ns0:layout_width="match_parent"
                    ns0:layout_height="wrap_content"
                    ns0:text="@string/design_post_body"
                    ns0:textSize="14sp"
                    ns0:textColor="@color/white"
                    ns0:lineSpacingExtra="3dp"
                    ns0:layout_marginTop="10dp" />
            </LinearLayout>
            <ImageView
                ns0:layout_width="72dp"
                ns0:layout_height="108dp"
                ns0:src="@drawable/hero_route"
                ns0:contentDescription="@null"
                ns0:importantForAccessibility="no"
                ns0:layout_marginStart="4dp" />
        </LinearLayout>
        <TextView
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="16dp"
            ns0:text="@string/create_ride_heading"
            ns0:textAppearance="?attr/textAppearanceHeadlineSmall"
            ns0:lineSpacingExtra="3dp"
            ns0:textSize="26sp"
            ns0:fontFamily="sans-serif-medium"
            ns0:accessibilityHeading="true" />
        <TextView
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:text="@string/design_post_route"
            ns0:textSize="16sp"
            ns0:textColor="@color/app_ink"
            ns0:lineSpacingExtra="3dp"
            ns0:fontFamily="sans-serif-medium"
            ns0:layout_marginTop="12dp"
            ns0:layout_marginBottom="12dp" />
        <com.google.android.material.textfield.TextInputLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:hint="@string/create_ride_title">
            <com.google.android.material.textfield.TextInputEditText
                ns0:id="@+id/title_input"
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:inputType="textCapSentences"
                ns0:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:hint="@string/create_ride_origin">
            <com.google.android.material.textfield.TextInputEditText
                ns0:id="@+id/origin_input"
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:inputType="textPostalAddress"
                ns0:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:hint="@string/create_ride_destination">
            <com.google.android.material.textfield.TextInputEditText
                ns0:id="@+id/destination_input"
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:inputType="textPostalAddress"
                ns0:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:text="@string/design_post_when"
            ns0:textSize="16sp"
            ns0:textColor="@color/app_ink"
            ns0:lineSpacingExtra="3dp"
            ns0:fontFamily="sans-serif-medium"
            ns0:layout_marginTop="12dp"
            ns0:layout_marginBottom="12dp" />
        <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/date_button"
                style="@style/Widget.Trojan.Secondary"
                ns0:layout_width="0dp"
                ns0:layout_height="wrap_content"
                ns0:layout_marginEnd="8dp"
                ns0:layout_weight="3"
                ns0:text="@string/create_ride_choose_date"
                ns0:minHeight="56dp"
                ns0:textAllCaps="false"
                ns0:layout_marginTop="4dp" />
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/time_button"
                style="@style/Widget.Trojan.Secondary"
                ns0:layout_width="0dp"
                ns0:layout_height="wrap_content"
                ns0:layout_weight="2"
                ns0:text="@string/create_ride_choose_time"
                ns0:minHeight="56dp"
                ns0:textAllCaps="false"
                ns0:layout_marginTop="4dp" />
        </LinearLayout>
        <TextView
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:text="@string/create_ride_time_zone"
            ns0:textAppearance="?attr/textAppearanceBodySmall"
            ns0:lineSpacingExtra="3dp" />
        <TextView
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:text="@string/design_post_group"
            ns0:textSize="16sp"
            ns0:textColor="@color/app_ink"
            ns0:lineSpacingExtra="3dp"
            ns0:fontFamily="sans-serif-medium"
            ns0:layout_marginTop="12dp"
            ns0:layout_marginBottom="12dp" />
        <LinearLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:gravity="center_vertical"
            ns0:orientation="horizontal">
            <TextView
                ns0:layout_width="0dp"
                ns0:layout_height="wrap_content"
                ns0:layout_weight="1"
                ns0:text="@string/create_ride_max_riders"
                ns0:textAppearance="?attr/textAppearanceBodyLarge"
                ns0:lineSpacingExtra="3dp" />
            <Spinner
                ns0:id="@+id/max_riders_spinner"
                ns0:layout_width="wrap_content"
                ns0:layout_height="52dp"
                ns0:background="@drawable/bg_card"
                ns0:paddingStart="12dp"
                ns0:paddingEnd="12dp"
                ns0:minHeight="52dp"
                ns0:layout_marginBottom="8dp" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:hint="@string/create_ride_cost"
            ns1:prefixText="$">
            <com.google.android.material.textfield.TextInputEditText
                ns0:id="@+id/cost_input"
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:inputType="numberDecimal"
                ns0:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:layout_marginBottom="12dp"
            ns0:hint="@string/create_ride_note">
            <com.google.android.material.textfield.TextInputEditText
                ns0:id="@+id/note_input"
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:gravity="top"
                ns0:inputType="textMultiLine|textCapSentences"
                ns0:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>
        <include ns0:id="@+id/loading_error" layout="@layout/view_loading_error" />
        <com.google.android.material.button.MaterialButton
            ns0:id="@+id/create_button"
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:text="@string/create_ride_submit"
            style="@style/Widget.Trojan.Button"
            ns0:minHeight="56dp"
            ns0:textAllCaps="false"
            ns0:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>