<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Complete your ride" android:textColor="@color/app_ink" android:textAppearance="@style/TextAppearance.Trojan.Title" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Review the actual cost and everyone’s share." android:textColor="@color/app_muted" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Total ride cost" android:textColor="@color/app_ink" android:textSize="17sp" android:textStyle="bold" />
        <EditText android:id="@+id/inputTotalCost" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:backgroundTint="@color/brand_primary" android:hint="0.00" android:inputType="numberDecimal" android:singleLine="true" android:textColor="@color/app_ink" android:textSize="23sp" android:importantForAutofill="no" style="@style/Widget.Trojan.Input" android:layout_marginBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="How should we split?" android:textColor="@color/app_ink" android:textSize="17sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/groupSplitMethod" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <RadioButton android:id="@+id/radioEqual" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/brand_primary" android:checked="true" android:text="Equal split" android:textColor="@color/app_ink" />
            <RadioButton android:id="@+id/radioCustom" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:buttonTint="@color/brand_primary" android:text="Custom split" android:textColor="@color/app_ink" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="Everyone's share" android:textColor="@color/app_ink" android:textSize="17sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/containerShares" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
        <TextView android:id="@+id/textSplitError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/app_error" android:textSize="13sp" android:visibility="gone" />
        <Button android:id="@+id/buttonCompleteRide" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp" android:backgroundTint="@color/brand_primary" android:text="Complete Ride" android:textAllCaps="false" android:textColor="@color/brand_on_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Make sure everyone's share looks right before confirming." android:textColor="@color/app_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
