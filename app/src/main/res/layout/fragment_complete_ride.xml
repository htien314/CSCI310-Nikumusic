<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete ride"
            android:textColor="@color/app_ink"
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/design_split_intro"
            android:textColor="@color/app_muted"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Total ride cost"
            android:textColor="@color/app_ink"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            style="@style/Widget.Trojan.Input"
            android:hint="Actual total cost"
            app:prefixText="$">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTotalCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textColor="@color/app_ink"
                android:textSize="16sp"
                android:importantForAutofill="no"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="How should we split?"
            android:textColor="@color/app_ink"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />
        <RadioGroup
            android:id="@+id/groupSplitMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/radioEqual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/app_primary"
                android:checked="true"
                android:text="Equal split"
                android:textColor="@color/app_ink"
                android:minHeight="52dp" />
            <RadioButton
                android:id="@+id/radioCustom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/app_primary"
                android:text="Custom split"
                android:textColor="@color/app_ink"
                android:minHeight="52dp" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Everyone's share"
            android:textColor="@color/app_ink"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />
        <LinearLayout
            android:id="@+id/containerShares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/textSplitError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/app_error"
            android:textSize="14sp"
            android:visibility="gone"
            android:lineSpacingExtra="3dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCompleteRide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Complete Ride"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Widget.Trojan.Button"
            android:minHeight="56dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Make sure everyone's share looks right before confirming."
            android:textColor="@color/app_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>