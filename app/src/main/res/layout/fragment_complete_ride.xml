<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Page header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete your ride ✨"
            android:textColor="#302347"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Let's split the cost fairly!"
            android:textColor="#746985"
            android:textSize="15sp" />

        <!-- Actual ride cost -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Total ride cost"
            android:textColor="#302347"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputTotalCost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#9A79CE"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:textColor="#302347"
            android:textSize="23sp"
            android:importantForAutofill="no" />

        <!-- Split options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="How should we split?"
            android:textColor="#302347"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/groupSplitMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioEqual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#8667BC"
                android:checked="true"
                android:text="Equal split"
                android:textColor="#302347" />

            <RadioButton
                android:id="@+id/radioCustom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#8667BC"
                android:text="Custom split"
                android:textColor="#302347" />
        </RadioGroup>

        <!-- Participant cost preview -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Everyone's share"
            android:textColor="#302347"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/containerShares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textSplitError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B3261E"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Completion action -->
        <Button
            android:id="@+id/buttonCompleteRide"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#8667BC"
            android:text="Complete Ride"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Make sure everyone's share looks right before confirming."
            android:textColor="#746985"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
