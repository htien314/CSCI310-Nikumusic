<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="My Profile"
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/app_ink"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/design_profile_intro"
            android:textSize="15sp"
            android:textColor="@color/app_muted"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="20dp" />
        <TextView
            android:id="@+id/profileMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            android:lineSpacingExtra="3dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileLogoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/profile_log_out"
            android:visibility="gone"
            style="@style/Widget.Trojan.TextButton"
            android:minHeight="56dp"
            android:textAllCaps="false"
            android:layout_marginTop="4dp"
            android:layout_gravity="end" />
        <TextView
            android:id="@+id/profilePaymentFlags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_payment_flags"
            android:visibility="gone"
            android:lineSpacingExtra="3dp" />
        <LinearLayout
            android:id="@+id/profileSignedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_card"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/profileFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:textSize="26sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/profileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/profileUscId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/profileGraduationYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nickname"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Trojan.Input"
                android:hint="Enter your nickname">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profileNickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileSaveNicknameButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Save Nickname"
                style="@style/Widget.Trojan.Secondary"
                android:minHeight="56dp"
                android:textAllCaps="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Upcoming Rides"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:id="@+id/profileUpcomingRides"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loading upcoming rides..."
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_soft"
                android:padding="16dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Public Ride Sharing"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Choose which upcoming and completed rides appear on your public profile."
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
            <LinearLayout
                android:id="@+id/profileSharingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading sharing preferences..."
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileViewHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="View Ride History"
                style="@style/Widget.Trojan.Secondary"
                android:minHeight="56dp"
                android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/profileSignedOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_brand"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MOVE TOGETHER"
                        android:textSize="10sp"
                        android:textColor="@color/usc_gold"
                        android:lineSpacingExtra="3dp"
                        android:letterSpacing="0.18"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/design_welcome"
                        android:textSize="31sp"
                        android:textColor="@color/white"
                        android:fontFamily="serif"
                        android:lineSpacingExtra="1dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/design_welcome_body"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="128dp"
                    android:src="@drawable/hero_route"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/design_how_it_works"
                android:textSize="12sp"
                android:textColor="@color/app_muted"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Please log in or register to view your profile."
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileLoginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log In"
                style="@style/Widget.Trojan.Button"
                android:minHeight="56dp"
                android:textAllCaps="false"
                android:layout_marginTop="4dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileRegisterButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Register"
                style="@style/Widget.Trojan.Secondary"
                android:minHeight="56dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>