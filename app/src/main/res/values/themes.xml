<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Base.Theme.TrojanRideShare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_tint</item>
        <item name="colorOnPrimaryContainer">@color/app_ink</item>
        <item name="colorSecondary">@color/app_primary</item>
        <item name="colorOnSecondary">@color/app_on_primary</item>
        <item name="colorSecondaryContainer">@color/app_soft</item>
        <item name="colorOnSecondaryContainer">@color/app_ink</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_ink</item>
        <item name="colorOnSurfaceVariant">@color/app_muted</item>
        <item name="colorSurfaceVariant">@color/app_background</item>
        <item name="colorOutline">@color/app_line</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/app_ink</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="materialButtonStyle">@style/Widget.Trojan.Button</item>
        <item name="textInputStyle">@style/Widget.Trojan.Input</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Trojan.Heading</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Trojan.Body</item>
    </style>
    <style name="Theme.TrojanRideShare" parent="Base.Theme.TrojanRideShare" />
    <style name="TextAppearance.Trojan.Heading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/app_ink</item>
    </style>
    <style name="TextAppearance.Trojan.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_ink</item>
    </style>
    <style name="Widget.Trojan.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="Widget.Trojan.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/app_line</item>
    </style>
    <style name="Widget.Trojan.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.Trojan.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/app_surface</item>
        <item name="boxStrokeColor">@color/app_line</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="Widget.Trojan.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/app_line</item>
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.Trojan.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/app_soft</item>
    </style>
</resources>