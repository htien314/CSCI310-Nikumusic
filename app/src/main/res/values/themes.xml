<resources>
    <style name="Base.Theme.TrojanRideShare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/app_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/app_background</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurface">@color/app_ink</item>
        <item name="colorOnSurfaceVariant">@color/app_muted</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorOutlineVariant">@color/app_outline</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/app_ink</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="materialButtonStyle">@style/Widget.Trojan.Button</item>
        <item name="textInputStyle">@style/Widget.Trojan.TextInput</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Trojan.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Trojan.Medium</item>
    </style>
    <style name="Theme.TrojanRideShare" parent="Base.Theme.TrojanRideShare" />
    <style name="Widget.Trojan.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="Widget.Trojan.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/app_surface</item>
    </style>
    <style name="Widget.Trojan.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/app_ink</item>
        <item name="android:textColorHint">@color/app_muted</item>
    </style>
    <style name="ShapeAppearance.Trojan.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Trojan.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="TextAppearance.Trojan.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/app_ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Trojan.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/app_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
